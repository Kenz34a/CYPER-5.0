# Local test: leave DATABASE_URL empty to use .data/players.json.
PORT=3000
NODE_ENV=development
COOKIE_SECURE=0
TRUST_PROXY=0
DATABASE_URL=
# Optional Google login: configure all three on the server, then restart.
# Keep the secret private; never put it in .env.mobile or commit it.
# Local web testing: PUBLIC_URL=http://localhost:3000
# Production/native: PUBLIC_URL is the actual root HTTPS URL on Render.
PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Paste the Neon pooled connection string into your PRIVATE .env or Render secrets.
# Remote PostgreSQL connections always verify TLS certificates.
